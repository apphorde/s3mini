{
  "name": "s3mini",
  "version": "0.1.0",
  "description": "A minimal S3-compatible object storage server in TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fast-querystring": "^1.1.2",
    "fastify": "^5.6.0",
