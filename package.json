    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.1.0"
  }
