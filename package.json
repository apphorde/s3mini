{
  "name": "@cloud-cli/s3mini",
  "version": "0.1.0",
  "description": "A minimal S3-compatible object storage server in TypeScript",
  "keywords": [
    "s3",
    "object-storage",
    "minio",
    "backblaze",
    "storage-server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apphorde/s3mini.git"
  },
  "bugs": {
    "url": "https://github.com/apphorde/s3mini/issues"
  },
  "homepage": "https://github.com/apphorde/s3mini#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fast-querystring": "^1.1.2",
    "fastify": "^5.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
}
