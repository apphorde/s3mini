# Dashboard OIDC configuration
AUTH_PROVIDER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:9000/auth/callback
S3MINI_OIDC_AUTH_URL=
S3MINI_OIDC_CLIENT_ID=
S3MINI_OIDC_CLIENT_SECRET=
S3MINI_OIDC_REDIRECT_URI=http://localhost:9000/auth/callback
S3MINI_OIDC_AUDIENCE=
S3MINI_OIDC_ADMIN_EMAILS=

# S3-compatible signing and local deployment identity
LOG_LEVEL=error
S3MINI_HOST=0.0.0.0
S3MINI_PORT=9000
S3MINI_REGION=local
S3MINI_NODE_ID=node-a

# Optional static admin fallback for local/testing deployments only
S3MINI_ADMIN_TOKEN=

# Asynchronous replication. Use a unique NODE_ID on every machine.
S3MINI_REPLICATION_PEERS=
S3MINI_REPLICATION_TOKEN=
S3MINI_REPLICATION_QUORUM=0
